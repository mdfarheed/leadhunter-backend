PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (mongodb+srv://user:pass@cluster.../leadhunter)
MONGODB_URI=YOUR_LIVE_MONGODB_ATLAS_CONNECTION_STRING

# Use a long random string (>= 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=YOUR_STRONG_RANDOM_JWT_SECRET
JWT_EXPIRES_IN=7d

# Google Places API (New) key. Backend only - never put this in the frontend.
GOOGLE_PLACES_API_KEY=YOUR_GOOGLE_PLACES_API_KEY

# Comma separated list of allowed browser origins
FRONTEND_URL=http://localhost:5173

# true = saving a Google result stores only the Place ID + fields you type yourself (recommended).
# false = prefill the save form with Google data (only if you hold permission to store it).
GOOGLE_STRICT_STORAGE=true

# Set to true when running behind a proxy/load balancer (Render, Railway, Nginx...)
TRUST_PROXY=false
# Set to true to let this server also serve ../frontend/dist (single-service deployment)
SERVE_FRONTEND=false
